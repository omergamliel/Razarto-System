{
  "name": "User",
  "type": "object",
  "properties": {
    "serial_id": {
      "type": "number",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e1\u05e4\u05e8\u05d9 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "is_authorized": {
      "type": "boolean",
      "default": false,
      "description": "\u05de\u05d5\u05e0\u05e2 \u05d2\u05d9\u05e9\u05d4 \u05dc\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05e2\u05d3 \u05e9\u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05de\u05e9\u05dc\u05d9\u05dd onboarding \u05d5\u05de\u05d0\u05d5\u05de\u05ea \u05de\u05d5\u05dc \u05e8\u05e9\u05d9\u05de\u05ea AuthorizedPerson. \u05e0\u05db\u05ea\u05d1 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d6\u05e8\u05d9\u05de\u05ea \u05d4-onboarding \u05d1\u05e6\u05d3 \u05d4\u05dc\u05e7\u05d5\u05d7 (auth.updateMe) \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d4\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d0\u05d5\u05de\u05ea \u05de\u05d5\u05dc \u05e8\u05e9\u05d9\u05de\u05ea AuthorizedPerson \u2014 \u05e9\u05db\u05df \u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d5\u05ea \u05e9\u05e8\u05ea \u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05ea\u05d5\u05db\u05e0\u05d9\u05ea Builder+. \u05e9\u05db\u05d1\u05ea \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d4\u05d9\u05d0 \u05d4-whitelist \u05d1-AuthorizedRoute."
    }
  },
  "required": [
    "serial_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}