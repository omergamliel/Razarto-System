{
  "name": "AuthorizedPerson",
  "type": "object",
  "properties": {
    "serial_id": {
      "type": "number",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e1\u05e4\u05e8\u05d9 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9"
    },
    "full_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "department": {
      "type": "string",
      "enum": [
        "\u05d0",
        "\u05de",
        "\u05ea"
      ],
      "description": "\u05de\u05d7\u05dc\u05e7\u05d4"
    },
    "email": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05de\u05d9\u05d9\u05dc"
    },
    "permissions": {
      "type": "string",
      "enum": [
        "None",
        "Viewer",
        "RR",
        "Manager",
        "Admin"
      ],
      "description": "\u05e8\u05de\u05ea \u05d4\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u2014 'None' \u05d0\u05d9\u05e0\u05d5 \u05de\u05d0\u05e4\u05e9\u05e8 \u05db\u05e0\u05d9\u05e1\u05d4 \u05dc\u05de\u05e2\u05e8\u05db\u05ea; 'Viewer' \u05de\u05d0\u05e4\u05e9\u05e8 \u05e6\u05e4\u05d9\u05d9\u05d4 \u05d1\u05dc\u05d1\u05d3 (\u05db\u05de\u05d5 RR \u05dc\u05dc\u05d0 \u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05dc\u05e7\u05d7\u05ea \u05d0\u05d5 \u05dc\u05e9\u05e0\u05d5\u05ea \u05de\u05e9\u05de\u05e8\u05d5\u05ea)"
    },
    "sign": {
      "type": "string",
      "description": "\u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u2014 \u05e9\u05dd \u05e7\u05d1\u05d5\u05e6\u05d4 (symbol) \u05d3\u05d9\u05e0\u05de\u05d9 \u05de\u05ea\u05d5\u05da \u05d9\u05e9\u05d5\u05ea ShiftGroup; \u05d4\u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05e0\u05d9\u05ea\u05e0\u05d5\u05ea \u05dc\u05d4\u05d5\u05e1\u05e4\u05d4/\u05d4\u05e1\u05e8\u05d4 \u05d1\u05dc\u05e9\u05d5\u05e0\u05d9\u05ea '\u05e0\u05d9\u05d4\u05d5\u05dc \u05e7\u05d1\u05d5\u05e6\u05d5\u05ea'"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "update": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "delete": {
      "user_condition": {
        "data.is_authorized": true
      }
    }
  }
}