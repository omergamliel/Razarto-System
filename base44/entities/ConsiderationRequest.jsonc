{
  "name": "ConsiderationRequest",
  "type": "object",
  "properties": {
    "serial_id": {
      "type": "number",
      "description": "serial_id \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d1\u05d9\u05e7\u05e9 \u05d4\u05ea\u05d7\u05e9\u05d1\u05d5\u05ea \u05d1\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d1\u05e7\u05e9 \u2014 \u05e0\u05e9\u05de\u05e8 \u05e2\u05dc \u05d4\u05de\u05d1\u05e7\u05e9\u05d4 \u05db\u05d3\u05d9 \u05e9\u05d4\u05d1\u05e7\u05e9\u05d4 \u05ea\u05d9\u05e9\u05d0\u05e8 \u05e7\u05e8\u05d9\u05d0\u05d4 \u05d2\u05dd \u05d0\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e0\u05de\u05d7\u05e7"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05d4\u05ea\u05d0\u05e8\u05d9\u05da \u05e9\u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05de\u05d1\u05e7\u05e9 \u05dc\u05d4\u05ea\u05d7\u05e9\u05d1 \u05d1\u05d5 (yyyy-MM-dd) \u2014 \u05d9\u05d5\u05dd \u05e9\u05de\u05d5\u05e8 \u05d1\u05d7\u05dc\u05d5\u05e7\u05ea \u05d4\u05de\u05e9\u05de\u05e8\u05d5\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d1\u05e7\u05e9\u05d4 \u2014 pending \u05de\u05de\u05ea\u05d9\u05e0\u05d4 \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 \u05de\u05e0\u05d4\u05dc, accepted \u05d0\u05d5\u05e9\u05e8\u05d4 (\u05e0\u05dc\u05e7\u05d7\u05ea \u05d1\u05d7\u05e9\u05d1\u05d5\u05df \u05d1\u05d7\u05dc\u05d5\u05e7\u05d4), rejected \u05e0\u05d3\u05d7\u05ea\u05d4"
    },
    "note": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d4 \u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9\u05ea \u05de\u05d4\u05de\u05d1\u05e7\u05e9 (\u05e1\u05d9\u05d1\u05ea \u05d4\u05d1\u05e7\u05e9\u05d4)"
    },
    "decided_by": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e0\u05d4\u05dc \u05e9\u05d0\u05d9\u05e9\u05e8/\u05d3\u05d7\u05d4 \u05d0\u05ea \u05d4\u05d1\u05e7\u05e9\u05d4"
    }
  },
  "required": [
    "serial_id",
    "date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "create": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "update": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "delete": {
      "user_condition": {
        "data.is_authorized": true
      }
    }
  }
}