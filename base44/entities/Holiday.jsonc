{
  "name": "Holiday",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d7\u05d2 (\u05dc\u05de\u05e9\u05dc '\u05e1\u05d5\u05db\u05d5\u05ea'). \u05e2\u05e8\u05d1 \u05d4\u05d7\u05d2 \u05e0\u05db\u05dc\u05dc \u05d1\u05d0\u05d5\u05ea\u05d5 \u05d8\u05d5\u05d5\u05d7 \u2014 '\u05e2\u05e8\u05d1 \u05e4\u05e1\u05d7' \u05d0\u05d9\u05e0\u05d5 \u05e8\u05e9\u05d5\u05de\u05d4 \u05e0\u05e4\u05e8\u05d3\u05ea \u05d0\u05dc\u05d0 \u05d7\u05dc\u05e7 \u05de\u05d4\u05d7\u05d2 \u05e2\u05e6\u05de\u05d5"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d7\u05d2 (yyyy-MM-dd) \u2014 \u05db\u05d5\u05dc\u05dc \u05d9\u05d5\u05dd \u05e2\u05e8\u05d1 \u05d4\u05d7\u05d2 \u05db\u05e9\u05d4\u05d5\u05d0 \u05e0\u05db\u05dc\u05dc \u05d1\u05d8\u05d5\u05d5\u05d7"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05d4\u05d7\u05d2 (yyyy-MM-dd). \u05e8\u05d9\u05e7/\u05d6\u05d4\u05d4 \u05dc\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d4\u05ea\u05d7\u05dc\u05d4 = \u05d9\u05d5\u05dd \u05d1\u05d5\u05d3\u05d3"
    },
    "divisions": {
      "type": "number",
      "default": 1,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d7\u05dc\u05d5\u05e7\u05d5\u05ea \u2014 \u05d1\u05d9\u05df \u05db\u05de\u05d4 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e9\u05d5\u05e0\u05d9\u05dd \u05de\u05ea\u05d7\u05dc\u05e7\u05d5\u05ea \u05d4\u05de\u05e9\u05de\u05e8\u05d5\u05ea \u05e9\u05dc \u05d4\u05d7\u05d2. 1 = \u05db\u05dc \u05de\u05e9\u05de\u05e8\u05d5\u05ea \u05d4\u05d7\u05d2 \u05e0\u05e9\u05d0\u05e8\u05d5\u05ea \u05d0\u05e6\u05dc \u05d0\u05d5\u05ea\u05d5 \u05d0\u05d3\u05dd, 2 = \u05e9\u05ea\u05d9 \u05de\u05e9\u05de\u05e8\u05d5\u05ea (\u05e8\u05e6\u05d5\u05e4\u05d5\u05ea) \u05dc\u05d0\u05d3\u05dd \u05d5\u05db\u05df \u05d4\u05dc\u05d0\u05d4. \u05d1\u05e8\u05d9\u05e8\u05ea \u05d4\u05de\u05d7\u05d3\u05dc \u05d4\u05d9\u05d0 2 \u05de\u05e9\u05de\u05e8\u05d5\u05ea \u05dc\u05d0\u05d3\u05dd, \u05db\u05dc\u05d5\u05de\u05e8 \u05de\u05e1\u05e4\u05e8 \u05d4\u05d7\u05dc\u05d5\u05e7\u05d5\u05ea \u05e0\u05d2\u05d6\u05e8 \u05de\u05d0\u05d5\u05e8\u05da \u05d4\u05d7\u05d2"
    },
    "division_breaks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e0\u05e7\u05d5\u05d3\u05d5\u05ea \u05d4\u05d7\u05dc\u05d5\u05e7\u05d4 \u05e9\u05e0\u05e7\u05d1\u05e2\u05d5 \u05d9\u05d3\u05e0\u05d9\u05ea \u2014 \u05d4\u05ea\u05d0\u05e8\u05d9\u05db\u05d9\u05dd (yyyy-MM-dd) \u05e9\u05d1\u05d4\u05dd \u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05d7\u05dc\u05d5\u05e7\u05d4 \u05d7\u05d3\u05e9\u05d4. \u05d0\u05d5\u05e8\u05da \u05d4\u05de\u05e2\u05e8\u05da + 1 = \u05de\u05e1\u05e4\u05e8 \u05d4\u05d7\u05dc\u05d5\u05e7\u05d5\u05ea \u05d1\u05e4\u05d5\u05e2\u05dc. \u05e8\u05d9\u05e7 = \u05d7\u05dc\u05d5\u05e7\u05d4 \u05e9\u05d5\u05d5\u05d4 \u05dc\u05e4\u05d9 divisions"
    }
  },
  "required": [
    "name",
    "start_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
