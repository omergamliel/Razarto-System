{
  "name": "ShiftGroup",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4 (\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9) \u2014 \u05db\u05dc \u05e8\u05e9\u05d5\u05de\u05d4 \u05de\u05d2\u05d3\u05d9\u05e8\u05d4 \u05e7\u05d1\u05d5\u05e6\u05d4. \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3/\u05dc\u05d4\u05e1\u05d9\u05e8 \u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05d1\u05dc\u05e9\u05d5\u05e0\u05d9\u05ea '\u05e0\u05d9\u05d4\u05d5\u05dc \u05e7\u05d1\u05d5\u05e6\u05d5\u05ea'"
    },
    "serial_id": {
      "type": "number",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05d9\u05d3\u05d5\u05e8\u05d9 (serial_id) \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05e4\u05e2\u05d9\u05dc \u05d1\u05e7\u05d1\u05d5\u05e6\u05d4 (\u05d0\u05dd \u05e7\u05d9\u05d9\u05dd)"
    },
    "active": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05e7\u05d9\u05d9\u05dd \u05de\u05e9\u05ea\u05de\u05e9 \u05e4\u05e2\u05d9\u05dc \u05d1\u05e7\u05d1\u05d5\u05e6\u05d4"
    }
  },
  "required": [
    "symbol"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}