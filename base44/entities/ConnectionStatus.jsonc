{
  "name": "ConnectionStatus",
  "type": "object",
  "properties": {
    "serial_id": {
      "type": "number",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e1\u05e4\u05e8\u05d9 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05de\u05e9\u05ea\u05de\u05e9 (\u05ea\u05d5\u05d0\u05dd AuthorizedPerson.serial_id \u05d5-User.serial_id)."
    },
    "connected": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05e9\u05dc\u05d9\u05dd onboarding \u05d5\u05de\u05d7\u05d5\u05d1\u05e8 (\u05de\u05e7\u05d1\u05d9\u05dc \u05dc-User.is_authorized), \u05d0\u05da \u05dc\u05dc\u05d0 \u05d7\u05e9\u05d9\u05e4\u05ea \u05d0\u05d9\u05de\u05d9\u05d9\u05dc/\u05e9\u05dd/\u05d4\u05e8\u05e9\u05d0\u05d4. \u05e0\u05db\u05ea\u05d1 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e2\u05e6\u05de\u05d5 \u05d1\u05e1\u05d9\u05d5\u05dd \u05d4-onboarding \u05db\u05d3\u05d9 \u05e9\u05de\u05e0\u05d4\u05dc\u05d9\u05dd \u05d9\u05d5\u05db\u05dc\u05d5 \u05dc\u05e8\u05d0\u05d5\u05ea \u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05d5\u05ea \u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05d1\u05dc\u05d9 \u05d2\u05d9\u05e9\u05ea read \u05dc-User."
    }
  },
  "required": [
    "serial_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "create": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "update": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}