{
  "name": "SwapRequest",
  "type": "object",
  "properties": {
    "shift_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d6\u05d4\u05d9 \u05d4\u05de\u05e9\u05de\u05e8\u05d5\u05ea \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05d5\u05ea \u05e9\u05d4\u05de\u05d1\u05e7\u05e9 \u05de\u05e6\u05d9\u05e2 \u05dc\u05d4\u05d7\u05dc\u05d9\u05e3"
    },
    "requesting_user_id": {
      "type": "number",
      "description": "serial_id \u05e9\u05dc \u05d4\u05de\u05d1\u05e7\u05e9"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "Partial",
        "Head2Head",
        "General"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d1\u05e7\u05e9\u05d4. General = \u05d1\u05e7\u05e9\u05d4 \u05e4\u05ea\u05d5\u05d7\u05d4 \u05dc\u05db\u05d0\u05df, \u05dc\u05dc\u05d0 \u05de\u05d5\u05e6\u05d0 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9"
    },
    "req_start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05ea \u05d4\u05d1\u05e7\u05e9\u05d4"
    },
    "req_end_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05d4\u05d1\u05e7\u05e9\u05d4"
    },
    "req_start_time": {
      "type": "string",
      "description": "\u05e9\u05e2\u05ea \u05d4\u05ea\u05d7\u05dc\u05d4 \u05de\u05d1\u05d5\u05e7\u05e9\u05ea"
    },
    "req_end_time": {
      "type": "string",
      "description": "\u05e9\u05e2\u05ea \u05e1\u05d9\u05d5\u05dd \u05de\u05d1\u05d5\u05e7\u05e9\u05ea"
    },
    "offered_shift_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d6\u05d4\u05d9 \u05de\u05e9\u05de\u05e8\u05d5\u05ea \u05de\u05d5\u05e6\u05e2\u05d5\u05ea (\u05e8\u05d0\u05e9 \u05d1\u05e8\u05d0\u05e9). \u05e8\u05d9\u05e7 \u05d1\u05d1\u05e7\u05e9\u05ea General \u05d4\u05e4\u05ea\u05d5\u05d7\u05d4 \u05dc\u05db\u05d0\u05df"
    },
    "gift_recipient_id": {
      "type": "number",
      "description": "Gift only: serial_id of the shift's owner at the moment the gift was offered \u2014 i.e. the person who accepts the offer and is freed from the shift. Captured at creation because ownership moves to the giver on accept, so it can't be recovered afterward (used to show both sides in the history view)."
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Partially_Covered",
        "Closed",
        "Cancelled"
      ],
      "default": "Open",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d1\u05e7\u05e9\u05d4"
    }
  },
  "required": [
    "shift_ids",
    "requesting_user_id",
    "request_type",
    "req_start_date",
    "req_end_date",
    "req_start_time",
    "req_end_time"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "create": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "update": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "delete": {
      "user_condition": {
        "data.is_authorized": true
      }
    }
  }
}