{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "actor_id": {
      "type": "number",
      "description": "serial_id \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d1\u05d9\u05e6\u05e2 \u05d0\u05ea \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "actor_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d1\u05d9\u05e6\u05e2 \u05d0\u05ea \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "action": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea (\u05dc\u05de\u05e9\u05dc: \u05d9\u05e6\u05d9\u05e8\u05ea \u05d1\u05e7\u05e9\u05ea \u05d4\u05d7\u05dc\u05e4\u05d4 \u05de\u05dc\u05d0\u05d4)"
    },
    "type": {
      "type": "string",
      "enum": [
        "\u05d1\u05e7\u05e9\u05d5\u05ea \u05d4\u05d7\u05dc\u05e4\u05d4",
        "\u05db\u05e0\u05d9\u05e1\u05d5\u05ea \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd",
        "\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
        "\u05d4\u05d5\u05e1\u05e4\u05ea \u05de\u05e9\u05de\u05e8\u05d5\u05ea",
        "\u05de\u05d7\u05d9\u05e7\u05ea \u05de\u05e9\u05de\u05e8\u05d5\u05ea",
        "\u05e9\u05d9\u05ea\u05d5\u05e4\u05d9\u05dd (WhatsApp, \u05d9\u05d5\u05de\u05df)",
        "\u05e2\u05d3\u05db\u05d5\u05df \u05de\u05e2\u05e8\u05db\u05ea"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 (\u05ea\u05d5\u05d0\u05de\u05ea \u05dc\u05de\u05e1\u05e0\u05df \u05d1\u05dc\u05e9\u05d5\u05e0\u05d9\u05ea \u05d4\u05dc\u05d5\u05d2\u05d9\u05dd)"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "warn",
        "error"
      ],
      "default": "ok",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4: \u05ea\u05e7\u05d9\u05df / \u05d7\u05e8\u05d9\u05d2 / \u05d0\u05e1\u05d5\u05e8"
    },
    "entity": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d9\u05e9\u05d5\u05ea \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05e9\u05d4\u05d5\u05e9\u05e4\u05e2\u05d4 (Shift, SwapRequest \u05d5\u05db\u05d5')"
    },
    "entity_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 \u05e9\u05d4\u05d5\u05e9\u05e4\u05e2\u05d4"
    },
    "details": {
      "type": "string",
      "description": "\u05e6\u05d9\u05dc\u05d5\u05dd \u05de\u05e6\u05d1 (JSON) \u05e9\u05dc \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 \u05d4\u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05d1\u05e2\u05ea \u05d9\u05e6\u05d9\u05e8\u05ea \u05d4\u05dc\u05d5\u05d2. \u05e9\u05d5\u05de\u05e8 \u05d0\u05ea \u05d4\u05e4\u05e8\u05d8\u05d9\u05dd \u05d1\u05ea\u05d5\u05da \u05d4\u05dc\u05d5\u05d2 \u05e2\u05e6\u05de\u05d5 \u05db\u05d3\u05d9 \u05e9\u05d9\u05d5\u05e6\u05d2\u05d5 \u05d2\u05dd \u05d0\u05dd \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea \u05e0\u05de\u05d7\u05e7\u05d4"
    }
  },
  "required": [
    "action",
    "type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "create": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "update": {
      "user_condition": {
        "data.is_authorized": true
      }
    },
    "delete": {
      "user_condition": {
        "data.is_authorized": true
      }
    }
  }
}